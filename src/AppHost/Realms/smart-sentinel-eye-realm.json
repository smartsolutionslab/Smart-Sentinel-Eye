{
  "realm": "smart-sentinel-eye",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "verifyEmail": false,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1)",
  "roles": {
    "realm": [
      { "name": "user", "description": "Standard user role" },
      { "name": "admin", "description": "Administrator role" }
    ]
  },
  "defaultRoles": ["user"],
  "groups": [
    {
      "name": "fabs",
      "subGroups": [
        { "name": "munich", "path": "/fabs/munich" },
        { "name": "dresden", "path": "/fabs/dresden" },
        { "name": "berlin", "path": "/fabs/berlin" },
        { "name": "hamburg", "path": "/fabs/hamburg" }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "sse.management",
      "description": "Legacy bundle (spec 001-007). Grandfathered until per-endpoint sse.*.write migration in spec 008 PR F. Grants permission only: identity claims moved to sse-identity in spec 042, so narrowing this cannot make a caller unattributable.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    { "name": "sse.cameras.read", "description": "Read camera catalogue.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.cameras.write", "description": "Mutate camera catalogue.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.streams.read", "description": "Read stream metadata.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.streams.write", "description": "Mutate stream resources.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.layouts.read", "description": "Read kiosk layouts.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.layouts.write", "description": "Author kiosk layouts.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.overlays.read", "description": "Read overlays.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.overlays.write", "description": "Author overlays.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.variables.read", "description": "Read system variables.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.variables.write", "description": "Mutate system variables.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.rules.read", "description": "Read automation rules.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.rules.write", "description": "Author automation rules.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.events.read", "description": "Read events ledger.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.events.write", "description": "Manual event ingest + webhook ingest.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.events.publish", "description": "MQTT publish on per-device topics.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.webhooks.write", "description": "Manage webhook integrations.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.identity.devices.write", "description": "Register and disable device clients.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.identity.kiosks.write", "description": "Enroll and disable kiosk clients.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.identity.devices.read", "description": "List registered device clients.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.identity.kiosks.read", "description": "List enrolled kiosk clients.", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "sse.audit.read", "description": "Read the bus-fed audit trail (spec 009).", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    {
      "name": "sse-groups",
      "description": "Emits /fabs/<id> group memberships into the 'groups' JWT claim.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "groups-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "name": "sse-identity",
      "description": "Emits the authenticated subject into the 'sub' JWT claim. Carries no permission: this realm defines its own clientScopes, so Keycloak's built-in basic scope does not exist and nothing else emits sub for an authorization-code flow (spec 042).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sse-audience",
      "description": "Names the API a token is for, in the access token's aud claim. Carries no permission (spec 069).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "smart-sentinel-eye-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [    {
      "clientId": "smart-sentinel-eye-web",
      "name": "Smart Sentinel Eye Web App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.management",
        "sse.audit.read"
      ]
    },
    {
      "clientId": "management-web",
      "name": "Smart Sentinel Eye â€” Management Web (spec 008 v2)",
      "description": "Replaces smart-sentinel-eye-web in spec 009.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.cameras.read",
        "sse.cameras.write",
        "sse.streams.read",
        "sse.streams.write",
        "sse.layouts.read",
        "sse.layouts.write",
        "sse.overlays.read",
        "sse.overlays.write",
        "sse.variables.read",
        "sse.variables.write",
        "sse.rules.read",
        "sse.rules.write",
        "sse.events.read",
        "sse.events.write",
        "sse.webhooks.write",
        "sse.identity.devices.write",
        "sse.identity.kiosks.write",
        "sse.identity.devices.read",
        "sse.identity.kiosks.read",
        "sse.audit.read"
      ]
    },
    {
      "clientId": "kiosk-web",
      "name": "Smart Sentinel Eye â€” Kiosk Web (spec 008 v2)",
      "description": "The kiosk app signs in here (spec 041). Scopes are exactly KeycloakScopeBundles.Kiosk. sub comes from sse-identity like every other client (spec 042).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.cameras.read",
        "sse.streams.read",
        "sse.layouts.read",
        "sse.overlays.read",
        "sse.variables.read",
        "sse.events.write"
      ]
    },
    {
      "clientId": "kiosk-wall",
      "name": "Smart Sentinel Eye - Kiosk Wall (spec 052)",
      "description": "Wall displays sign in here, not kiosk-web (spec 052). offline_access is OPTIONAL, never default. Carries no sse.events.write: scopes belong to clients, so this is the only place a wall display's authority can be narrowed.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5175/*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.cameras.read",
        "sse.streams.read",
        "sse.layouts.read",
        "sse.overlays.read",
        "sse.variables.read"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "identity-admin",
      "name": "Smart Sentinel Eye â€” Identity Admin (service account)",
      "description": "Used by the Identity API to create/rotate Keycloak clients via the Admin REST API.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-identity-admin-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience"
      ]
    },
    {
      "clientId": "migration-runner",
      "name": "Smart Sentinel Eye â€” Migration Runner (service account)",
      "description": "Reads /fabs so event partitions are provisioned per fab (spec 019). Read-only; see research.md R2 for why view-users is needed.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-migration-runner-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience"
      ]
    },
    {
      "clientId": "stream-distribution-attribution",
      "name": "Smart Sentinel Eye â€” Stream fab attribution (service account)",
      "description": "ADR-0116. Read-only account StreamDistribution uses at startup to learn the fab of a stream provisioned before spec 016. In every fab group on purpose: a stream's fab is what is unknown, so the lookup cannot be narrowed first.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-stream-distribution-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.cameras.read"
      ]
    },
    {
      "clientId": "scenario-simulator",
      "name": "Smart Sentinel Eye â€” Scenario Simulator (dev-only service account)",
      "description": "Dev-only (ADR-0111). Service account the Scenario Simulator worker uses to seed the camera catalog via client_credentials. Never deployed.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-scenario-simulator-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse-groups",
        "sse.cameras.write",
        "sse.cameras.read",
        "sse.overlays.write",
        "sse.rules.write",
        "sse.rules.read",
        "sse.layouts.write",
        "sse.layouts.read",
        "sse.overlays.read"
      ]
    },
    {
      "clientId": "event-ingestion",
      "name": "Smart Sentinel Eye â€” Event Ingestion MQTT subscriber (service account)",
      "description": "Service account the EventIngestion MQTT subscriber presents as its broker password (ADR-0100). The go-auth plugin enforces azp == MQTT username, so this clientId must match the 'event-ingestion' row in mosquitto/acl.txt that grants 'topic read fab/+/+/+'.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-event-ingestion-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience"
      ]
    },
    {
      "clientId": "system-variables-seeder",
      "name": "Smart Sentinel Eye - Reverse-index seeder (service account)",
      "description": "Spec 005 T061, delivered in spec 126. Read-only account SystemVariables uses at startup to list published overlays and seed the reverse index. No sse-groups: OverlayDesigner runs no fab guard and an overlay is fab-neutral (ADR-0115).",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "dev-only-system-variables-seeder-secret",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "sse-identity",
        "sse-audience",
        "sse.overlays.read"
      ]
    }
  ],
