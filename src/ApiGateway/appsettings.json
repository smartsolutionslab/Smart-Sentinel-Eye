{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "https://localhost:5173",
      "https://localhost:5174",
      "https://localhost:5175"
    ]
  },
  "RateLimiting": {
    "FabHeader": "X-Fab",
    "PermitLimit": 100,
    "Window": "00:01:00"
  },
  "ReverseProxy": {
    "Routes": {
      "camera-catalog": {
        "ClusterId": "camera-catalog",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/camera-catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/camera-catalog" } ]
      },
      "stream-distribution": {
        "ClusterId": "stream-distribution",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/stream-distribution/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/stream-distribution" } ]
      },
      "layout-composition": {
        "ClusterId": "layout-composition",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/layout-composition/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/layout-composition" } ]
      },
      "event-ingestion": {
        "ClusterId": "event-ingestion",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/event-ingestion/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/event-ingestion" } ]
      },
      "overlay-designer": {
        "ClusterId": "overlay-designer",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/overlay-designer/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/overlay-designer" } ]
      },
      "system-variables": {
        "ClusterId": "system-variables",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/system-variables/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/system-variables" } ]
      },
      "audit-observability": {
        "ClusterId": "audit-observability",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/audit-observability/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/audit-observability" } ]
      },
      "automation": {
        "ClusterId": "automation",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/automation/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/automation" } ]
      },
      "identity": {
        "ClusterId": "identity",
        "CorsPolicy": "gateway",
        "RateLimiterPolicy": "per-fab",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      }
    },
    "Clusters": {
      "camera-catalog": { "Destinations": { "primary": { "Address": "http://camera-catalog" } } },
      "stream-distribution": { "Destinations": { "primary": { "Address": "http://stream-distribution" } } },
      "layout-composition": { "Destinations": { "primary": { "Address": "http://layout-composition" } } },
      "event-ingestion": { "Destinations": { "primary": { "Address": "http://event-ingestion" } } },
      "overlay-designer": { "Destinations": { "primary": { "Address": "http://overlay-designer" } } },
      "system-variables": { "Destinations": { "primary": { "Address": "http://system-variables" } } },
      "audit-observability": { "Destinations": { "primary": { "Address": "http://audit-observability" } } },
      "automation": { "Destinations": { "primary": { "Address": "http://automation" } } },
      "identity": { "Destinations": { "primary": { "Address": "http://identity" } } }
    }
  }
}
