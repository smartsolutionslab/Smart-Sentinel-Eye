{
  "name": "smart-sentinel-eye",
  "private": true,
  "version": "0.0.0",
  "description": "Industrial CCTV camera management — workspace root",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/**\" build",
    "lint": "pnpm -r --filter \"./apps/**\" lint && pnpm lint:e2e",
    "lint:e2e": "eslint e2e playwright.config.ts --max-warnings 0",
    "test": "pnpm -r --filter \"./apps/**\" test && pnpm test:guards",
    "test:guards": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "pnpm -r --filter \"./apps/**\" typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "format": "prettier --write \"{apps,e2e}/**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\" playwright.config.ts",
    "format:check": "prettier --check \"{apps,e2e}/**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\" playwright.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
