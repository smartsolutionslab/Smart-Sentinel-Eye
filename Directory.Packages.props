<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers (transitively applied via Directory.Build.props) -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />

    <!-- Architecture tests -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- xUnit test stack (ADR-0052) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />

    <!-- Aspire integration testing (Integration.Tests fixture, ADR-0068 — pre-wired so the package resolves) -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />

    <!-- Aspire NodeJs integration: AppHost registers management-web and kiosk-web npm apps (ADR-0074) -->
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />

    <!-- Aspire infrastructure resources (ADR-0007 + ADR-0009 + ADR-0010). Version-aligned with
         Yumney's working .NET 10 stack. Keycloak hosting is preview-only at the moment. -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.3-preview.1.26425.3" />

    <!-- Aspire client integration for ASP.NET Core services that consume Postgres -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.5.2" />

    <!-- ASP.NET Core auth (ADR-0007 + ADR-0008 + ADR-0023). Plain JwtBearer; no Aspire
         Keycloak client package needed — realm URL comes from the Aspire-injected
         connection string. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!-- SignalR client for integration-test consumers (spec 003 PR E).
         The server-side SignalR types come from Microsoft.AspNetCore.App
         via the FrameworkReference; this is only needed in tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />

    <!-- EF Core for state-based contexts (ADR-0009) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Wolverine (ADR-0042, ADR-0057, ADR-0088). Version-aligned with Yumney. -->
    <PackageVersion Include="WolverineFx" Version="6.30.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.30.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.30.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.30.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.30.0" />
    <!-- Wolverine 6 dropped JasperFx.RuntimeCompiler from the core package, so
         runtime codegen is now opt-in. Both UseWolverine call sites run on the
         implicit TypeLoadMode.Dynamic, which fails fast at startup without an
         IAssemblyGenerator. Referenced by ServiceDefaults + ScenarioSimulator,
         the two hosts that call UseWolverine. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.30.0" />

    <!-- MQTT (spec 006, ADR-0096): .NET client for the Mosquitto broker (ADR-0095).
         v5 removed MQTTnet.Extensions.ManagedClient: that package stops at
         4.3.7.1207 and the core assembly exports no type named "Managed", so
         reconnect, resubscribe and per-attempt credential minting are ours to own
         (spec 079). MqttConnectionLoop and MqttPublisher each hold a copy. -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />

    <!-- MinIO object storage (spec 009 ADR-0101). Aspire hosting
         resource + typed client wrapper, both via the Aspire
         Community Toolkit. Transitively pulls in the official
         `Minio` .NET SDK. -->
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Minio" Version="13.5.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Minio.Client" Version="13.5.0" />

    <!-- ASP.NET Core / Hosting / Resilience / Service Discovery -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.9.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- OpenTelemetry (ADR-0026, ADR-0050) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <!-- Additional <PackageVersion Include="..." Version="..." /> -->
  <!-- entries added here as projects begin to reference packages. -->
</Project>
